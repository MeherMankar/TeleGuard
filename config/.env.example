# Telegram API Configuration
# Get these from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Android API Credentials for Device Spoofing (Optional)
# Create Android application at my.telegram.org
ANDROID_API_ID=your_android_api_id_here
ANDROID_API_HASH=your_android_api_hash_here

# Bot Configuration
# Get bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Database Configuration
# MongoDB connection string (required for durable storage)
MONGO_URI=mongodb://localhost:27017/teleguard
MONGODB_URI=mongodb://localhost:27017/teleguard
MONGO_DB_NAME=teleguard

# MongoDB Connection Settings
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=20000

# Redis connection string (required for ephemeral cache)
REDIS_URL=redis://localhost:6379/0

# Redis Connection Settings
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5

# Cache TTL Settings (seconds)
CACHE_TTL_SESSION_TOKEN=3600
CACHE_TTL_OTP_CODE=300
CACHE_TTL_TEMP_DATA=1800
CACHE_TTL_RATE_LIMIT=3600

# SQLite fallback database (legacy)
DATABASE_URL=sqlite+aiosqlite:///bot_data.db

# Backup Configuration (Optional)
# Enable automated session backup to GitHub
SESSION_BACKUP_ENABLED=false

# GitHub repository for session storage (SSH format recommended)
GITHUB_REPO=git@github.com:username/sessions-backup.git
GITHUB_TOKEN=your_github_token_here
GITHUB_BACKUP_BRANCH=backups

# GPG key ID for signing manifests
GPG_KEY_ID=your_gpg_key_id

# Fernet encryption key (base64 encoded)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_base64_fernet_key

# Telegram backup channel for user settings and IDs (use channel ID)
TELEGRAM_BACKUP_CHANNEL=-1001234567890

# Snapshot directory for backups
SNAPSHOT_DIR=/path/to/snapshots

# Sessions directory for storing session files
SESSIONS_DIR=/path/to/sessions

# Bot Configuration
MAX_ACCOUNTS=10
LOG_LEVEL=INFO
HEALTH_SERVER_PORT=8000
ENVIRONMENT=production

# Performance Settings
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
DATABASE_POOL_SIZE=10
MAX_CLIENT_IDLE_TIME=3600
HEALTH_CHECK_INTERVAL=300
KEEP_ALIVE_INTERVAL=3600

# Media Filter - Photo/Video Filter for Free Tier Optimization
# Enable to filter photos/videos from DM forwarding to save MongoDB storage
# Recommended: true for free tier (MongoDB Atlas 512MB, Koyeb free tier)
MEDIA_FILTER_ENABLED=true

# Security Settings
RATE_LIMIT_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=30
ENCRYPTION_KEY=your_encryption_key_here

# Topic Routing Configuration (Optional)
# Enable per-user topic messaging system (users configure their own forums)
FEATURE_TOPIC_ROUTING=true

# Message queuing uses same Redis instance as cache

# Topic settings
TOPIC_AUTO_ARCHIVE_DAYS=30
TOPIC_MAX_MESSAGES_PER_MINUTE=10

# Admin Configuration
# Comma-separated list of admin user IDs for Developer menu access
ADMIN_IDS=123456789,987654321

# Koyeb Platform Optimization
# Prevent IP changes and optimize stability
KOYEB_OPTIMIZATION_ENABLED=true
KOYEB_REGION=fra
KOYEB_KEEP_ALIVE=true
KOYEB_PREVENT_IDLE=true

# IP Monitoring & Network Optimization (Cloud Platform Support)
# Enable IP change detection and session protection
IP_MONITORING_ENABLED=true
IP_CHECK_INTERVAL=300
NOTIFY_ON_IP_CHANGE=true
SESSION_WARMUP_DELAY=30

# Session Guardian Configuration
# Rate limiting settings
MAX_MESSAGES_PER_MINUTE=20
MAX_JOINS_PER_HOUR=10
MAX_FORWARDS_PER_MINUTE=10
MAX_BULK_PER_MINUTE=5

# Retry settings
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=60.0

# Telegram logging for alerts (Optional)
LOG_BOT_TOKEN=your_log_bot_token
LOG_CHAT_ID=your_log_chat_id
TELEGRAM_LOGGING_ENABLED=true

# Session lock settings
SESSION_LOCK_ENABLED=true
SESSION_LOCK_TIMEOUT=300

# Emergency settings
AUTO_SHUTDOWN_ON_AUTH_ERROR=true
DELETE_SESSION_ON_REVOKE=false
NOTIFY_ADMIN_ON_ERROR=true

# Logging configuration
LOG_DIR=logs
SUMMARY_INTERVAL=36000


