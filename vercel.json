{
  "functions": {
    "backend/main.py": {
      "runtime": "python3.11",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "env": {
    "API_ID": "YOUR_API_ID",
    "API_HASH": "YOUR_API_HASH",
    "BOT_TOKEN": "YOUR_BOT_TOKEN",
    "FERNET_KEY": "YOUR_FERNET_KEY"
  },
  "build": {
    "env": {
      "PYTHON_VERSION": "3.11"
    }
  }
}
