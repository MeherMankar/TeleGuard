# TeleGuard Frontend — Environment Variables
# Copy this to .env.local for local dev, set these in Vercel dashboard for production

# URL of your TeleGuard backend (FastAPI)
# Local:      http://localhost:8080
# Production: https://your-backend.koyeb.app
VITE_API_URL=http://localhost:8080

# WebSocket URL of your TeleGuard backend
# Local:      ws://localhost:8080
# Production: wss://your-backend.koyeb.app
VITE_WS_URL=ws://localhost:8080
